# 두 분만 접속할 수 있도록 충분히 긴 임의 문자열을 사용하세요.
APP_ACCESS_KEY=change-this-to-a-long-random-key

# SQLite 데이터를 보관할 폴더입니다. 비워 두면 프로젝트의 data 폴더를 사용합니다.
APP_DATA_DIR=

# Next.js가 FastAPI로 요청을 전달할 내부 주소입니다.
BACKEND_URL=http://127.0.0.1:8000

# AI 분석. 비워 두면 SQLite 수치 기반 로컬 분석을 사용합니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# 목표가 도달 및 연결 테스트 알림입니다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Cloud 서비스 계정과 공유한 캘린더 정보입니다.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
