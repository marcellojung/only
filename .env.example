# 두 분만 접속할 수 있도록 충분히 긴 임의 문자열을 사용하세요.
APP_ACCESS_KEY=change-this-to-a-long-random-key

# 웹 호스팅에서 제공하는 비공개 PostgreSQL 연결 주소입니다.
DATABASE_URL=

# Google Cloud 서비스 계정과 공유한 캘린더 정보입니다.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
