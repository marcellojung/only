# Funnel 공개 운영에서는 legacy 접근 키를 사용하지 않습니다.
APP_ACCESS_KEY=
PUBLIC_ACCESS_MODE=funnel

# 가족별 로그인. 공개 운영 시 AUTH_SECRET은 32자 이상, 각 비밀번호는 서로 다른 12자 이상이어야 합니다.
AUTH_SECRET=change-this-to-a-32-character-random-secret
ADMIN_PASSWORD=
JIWOO_GUEST_PASSWORD=
YOONJAE_GUEST_PASSWORD=

# SQLite 데이터를 보관할 폴더입니다. 비워 두면 프로젝트의 data 폴더를 사용합니다.
APP_DATA_DIR=

# Next.js가 FastAPI로 요청을 전달할 내부 주소입니다.
BACKEND_URL=http://127.0.0.1:8000

# 서버가 켜져 있을 때 한국시간 기준으로 환율·주식·코인 시세를 자동 갱신합니다.
AUTO_REFRESH_ENABLED=true
AUTO_REFRESH_TIMES=09:00,13:00,17:00,21:00

# AI 분석. 비워 두면 SQLite 수치 기반 로컬 분석을 사용합니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# 선택 사항. Gowalter 블로그 JSON과 투자 관점 Markdown 파일이 있는 폴더입니다.
# 비우면 data/gowalter 또는 ~/Downloads/obsidian_note/personal/investing를 찾습니다.
GOWALTER_ARCHIVE_DIR=

# 종목 상세의 DART 기반 자체 기업 리포트입니다. LLM 키는 필요하지 않습니다.
OPENDART_API_KEY=

# 최근 종목 뉴스. 신규 신청은 NAVER API HUB를 사용합니다.
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=

# 기존 NAVER Developers 검색 API 키가 있을 때만 사용하세요.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 목표가 도달 및 연결 테스트 알림입니다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 권장: Google OAuth로 로그인한 계정의 기본·공유 캘린더 목록을 가져옵니다.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Google Cloud 승인된 리디렉션 URI와 정확히 같아야 합니다.
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.example/api/calendar/oauth/callback

# 기존 서비스 계정 단일 캘린더 연결은 호환용으로 계속 지원합니다.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
